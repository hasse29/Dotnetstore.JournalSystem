@using Dotnetstore.JournalSystem.FrontEnd.WebUi.Pages.Companies
@model DetailsModel
@{
    var company = Model.Company!;
    var hasActions = Model.CanEditContacts || Model.CanDeleteContacts;
    var canAdd = Model.CanAddContacts && Model.Addresses is not null && Model.AddressTypes.Count > 0;
}

<section class="card" aria-labelledby="addresses-heading" data-testid="addresses">
    <div class="card-header">
        <h2 id="addresses-heading">Addresses</h2>
        @if (canAdd)
        {
            <button type="button" class="btn btn-secondary" data-dialog-open="address-new" data-testid="address-add">Add address</button>
        }
    </div>

    @if (Model.Addresses is null)
    {
        <p class="muted" data-testid="addresses-unavailable">The addresses could not be loaded right now.</p>
    }
    else if (Model.Addresses.Count == 0)
    {
        <p class="muted" data-testid="addresses-empty">No addresses yet.</p>
    }
    else
    {
        <table class="table">
            <thead>
                <tr><th>Type</th><th>Address</th>@if (hasActions) { <th class="actions-col"><span class="visually-hidden">Actions</span></th> }</tr>
            </thead>
            <tbody>
                @foreach (var address in Model.Addresses)
                {
                    <tr data-testid="address-row">
                        <td>@(Model.AddressTypes.FirstOrDefault(x => x.Id == address.AddressTypeId)?.Name ?? "Unknown")</td>
                        <td>
                            @if (!string.IsNullOrEmpty(address.CO))
                            {
                                <div>c/o @address.CO</div>
                            }
                            <div>@address.Street1</div>
                            @if (!string.IsNullOrEmpty(address.Street2))
                            {
                                <div>@address.Street2</div>
                            }
                            <div>@address.PostalCode @address.City</div>
                            <div>@(string.IsNullOrEmpty(address.State) ? address.Country : $"{address.State}, {address.Country}")</div>
                        </td>
                        @if (hasActions)
                        {
                            <td class="actions-col">
                                <div class="row-actions">
                                    @if (Model.CanEditContacts)
                                    {
                                        <button type="button" class="btn btn-secondary" data-dialog-open="address-@address.Id" data-testid="address-edit">Edit</button>
                                    }
                                    @if (Model.CanDeleteContacts)
                                    {
                                        <form method="post" asp-page="/Companies/Details" asp-page-handler="DeleteAddress" asp-route-id="@company.Id" asp-route-contactId="@address.Id" data-confirm="Delete this address?">
                                            <button type="submit" class="btn btn-secondary btn-danger" data-testid="address-delete">Delete</button>
                                        </form>
                                    }
                                </div>
                                @if (Model.CanEditContacts)
                                {
                                    <partial name="_AddressDialog" model="(Model, address)" />
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }

    @if (canAdd)
    {
        <partial name="_AddressDialog" model="(Model, (Dotnetstore.JournalSystem.Shared.Responses.Contact.AddressResponse?)null)" />
    }
</section>
