@page
@using Dotnetstore.JournalSystem.Shared.Constants
@model Dotnetstore.JournalSystem.FrontEnd.WebUi.Pages.Admin.AccessRequestsModel
@{
    ViewData["Title"] = "Access requests";
}

<div class="page-header">
    <h1>Access requests</h1>
    <p>People who signed in with Microsoft and are waiting to be let in.</p>
</div>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-success" role="status" data-testid="access-message">@Model.Message</div>
}

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert" data-testid="access-error">@Model.ErrorMessage</div>
}

@if (Model.Forbidden)
{
    <div class="alert alert-danger" role="alert" data-testid="access-forbidden">
        You do not have permission to view access requests.
    </div>
}
else if (Model.Unavailable)
{
    <div class="alert alert-danger" role="alert" data-testid="api-unavailable">
        The API could not be reached. Access requests are not available right now.
    </div>
}
else
{
    <section class="card" aria-labelledby="pending-heading">
        <h2 id="pending-heading">Waiting for a decision</h2>
        @if (Model.Pending.Count == 0)
        {
            <p class="muted" data-testid="pending-empty">No one is waiting for access.</p>
        }
        else
        {
            <ul class="request-list" data-testid="pending-list">
                @foreach (var request in Model.Pending)
                {
                    <li class="request" data-testid="request-@request.Username">
                        <div class="request-who">
                            <strong>@request.DisplayName</strong>
                            <span class="muted">@request.Username</span>
                            <span class="muted">Requested @request.RequestedAt.ToString("yyyy-MM-dd HH:mm") UTC</span>
                        </div>

                        @if (Model.CanDecide)
                        {
                            <form method="post" asp-page-handler="Approve" asp-route-id="@request.Id" class="request-approve">
                                <div class="form-grid">
                                    <label>First name
                                        <input name="FirstName" value="@request.SuggestedFirstName" required maxlength="@DataSchemeConstants.UserNameMaxLength" data-testid="first-name" />
                                    </label>
                                    <label>Middle name
                                        <input name="MiddleName" maxlength="@DataSchemeConstants.UserNameMaxLength" data-testid="middle-name" />
                                    </label>
                                    <label>Last name
                                        <input name="LastName" value="@request.SuggestedLastName" required maxlength="@DataSchemeConstants.UserNameMaxLength" data-testid="last-name" />
                                    </label>
                                    <label>Gender
                                        <select name="Gender" required data-testid="gender">
                                            <option value="">Gender…</option>
                                            <option value="female">Female</option>
                                            <option value="male">Male</option>
                                        </select>
                                    </label>
                                    <label>Date of birth (optional)
                                        <input name="DateOfBirth" type="date" data-testid="date-of-birth" />
                                    </label>
                                    <label>Personal ID number (optional)
                                        <input name="SocialSecurityNumber" autocomplete="off" maxlength="@(DataSchemeConstants.PersonalIdentityNumberMaxLength + 1)" placeholder="YYYYMMDD-NNNN" data-testid="personal-id" />
                                    </label>
                                    <label>Role
                                        <select name="RoleId" required data-testid="role-select">
                                            <option value="">Role…</option>
                                            @foreach (var role in Model.Roles)
                                            {
                                                <option value="@role.Value">@role.Text</option>
                                            }
                                        </select>
                                    </label>
                                    <label>Company
                                        <select name="OwnCompanyId" required data-testid="company-select">
                                            @if (Model.Companies.Count != 1)
                                            {
                                                <option value="">Company…</option>
                                            }
                                            @foreach (var company in Model.Companies)
                                            {
                                                <option value="@company.Value">@company.Text</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <button type="submit" class="btn btn-primary" data-testid="approve">Approve</button>
                            </form>

                            <form method="post" asp-page-handler="Reject" asp-route-id="@request.Id" class="request-reject">
                                <label class="visually-hidden" for="note-@request.Id">Reason (optional)</label>
                                <input id="note-@request.Id" name="note" maxlength="@DataSchemeConstants.AccessRequestDecisionNoteMaxLength"
                                       placeholder="Reason (optional)" data-testid="reject-note" />
                                <button type="submit" class="btn btn-secondary" data-testid="reject">Reject</button>
                            </form>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="card" aria-labelledby="decided-heading">
        <h2 id="decided-heading">Decided</h2>
        @if (Model.Decided.Count == 0)
        {
            <p class="muted" data-testid="decided-empty">Nothing has been decided yet.</p>
        }
        else
        {
            <table class="table" data-testid="decided-table">
                <thead>
                    <tr><th>Name</th><th>Username</th><th>Decision</th><th>Decided (UTC)</th><th>Note</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Decided)
                    {
                        <tr data-testid="decided-@request.Username">
                            <td>@request.DisplayName</td>
                            <td>@request.Username</td>
                            <td><span class="badge badge-@request.Status.ToString().ToLowerInvariant()">@request.Status</span></td>
                            <td>@request.DecidedAt?.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@request.DecisionNote</td>
                            <td>
                                @if (Model.CanDecide && request.Status == AccessRequestStatus.Rejected)
                                {
                                    <form method="post" asp-page-handler="Reopen" asp-route-id="@request.Id">
                                        <button type="submit" class="btn btn-secondary" data-testid="reopen">Reopen</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}
