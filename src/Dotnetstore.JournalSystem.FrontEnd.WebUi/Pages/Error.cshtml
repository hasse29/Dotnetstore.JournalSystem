@page
@model ErrorModel
@{
    Layout = "_LoginLayout";
    ViewData["Title"] = "Error";
}

<h1 class="auth-title">Something went wrong</h1>
<p class="auth-subtitle">An error occurred while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p class="muted">Request ID: <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary btn-block" asp-page="/Dashboard/Index">Back to dashboard</a>
