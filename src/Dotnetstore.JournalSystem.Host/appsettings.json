{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60
  },
  "RequestLimits": {
    "MaxBodySizeBytes": 1048576,
    "MaxHeadersTotalSizeBytes": 32768,
    "HeadersTimeoutSeconds": 15,
    "RequestTimeoutSeconds": 30
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
