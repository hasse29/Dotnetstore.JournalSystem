<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <NoWarn>$(NoWarn);CA1515;CA1707;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.Playwright" />
    <PackageReference Include="Testcontainers.MsSql" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Dotnetstore.JournalSystem.FrontEnd.WebUi\Dotnetstore.JournalSystem.FrontEnd.WebUi.csproj" />
    <ProjectReference Include="..\..\src\Dotnetstore.JournalSystem.Host\Dotnetstore.JournalSystem.Host.csproj" />
  </ItemGroup>

</Project>
